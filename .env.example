# ============================================================================
# AERO-CEO v2 — every variable is validated at startup (src/aero/config.py).
# Unknown AERO_* names are an error, so a typo fails loudly instead of being ignored.
# ============================================================================

AERO_ENV=local                       # local | test | staging | prod
AERO_LOG_LEVEL=INFO
AERO_LOG_JSON=false

# Storage: SQLite for a single box, Postgres + pgvector for anything shared.
AERO_DATABASE_URL=sqlite:///data/aero_v2.sqlite
# AERO_DATABASE_URL=postgresql://aero:CHANGE_ME@localhost:5432/aero_ceo

# Embeddings: sentence-transformers (in-process, needs the local-models extra) | tei (HTTP) | hashing (tests only)
AERO_EMBEDDING_BACKEND=sentence-transformers
AERO_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
AERO_EMBEDDING_DIM=1024
# AERO_TEI_EMBED_URL=http://localhost:8080

# Reranking: none | cross-encoder (in-process) | tei
AERO_RERANKER_BACKEND=none
AERO_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# AERO_TEI_RERANK_URL=http://localhost:8081

# Retrieval. Ranking is relevance only (ADR 0008): there are no trust or recency weights.
# AERO_RETRIEVAL_CANDIDATE_K=50
# Admiralty source grades excluded unless a caller asks for them (A completely reliable ... F cannot be judged)
# AERO_RETRIEVAL_EXCLUDE_RELIABILITY=E

# LLM: an OpenAI-compatible endpoint (vLLM). Signals, verification, partner ranking and briefings need it;
# without it those commands refuse instead of falling back to heuristics.
# AERO_LLM_BASE_URL=http://localhost:8000/v1
# AERO_LLM_MODEL=qwen3.6-27b            # must equal vLLM's --served-model-name
# AERO_LLM_API_KEY=                     # if vLLM runs with --api-key
# AERO_LLM_MAX_CONCURRENCY=8
# AERO_JUDGE_MODEL=                     # a different checkpoint for verification, when one is served
# AERO_LLM_CASSETTE_MODE=off            # record on Data Lab, replay in CI (evals/cassettes)
# AERO_SIGNAL_SAMPLES=3                 # self-consistency samples per document

# Ingestion. Use a generic crawler name here, never a personal e-mail address.
# AERO_HTTP_USER_AGENT=AERO-CEO-research-crawler/2.0 (+https://github.com/keyurck7/aero-ceo)
AERO_HTTP_PER_DOMAIN_DELAY_SECONDS=1.0

# MCP servers
AERO_MCP_HOST=127.0.0.1
AERO_MCP_PORT=8101
# AERO_MCP_ALLOWED_HOSTS=localhost:*,evidence-mcp:8101
# AERO_STRATEGY_ALLOW_WRITES=false   # true = propose/approve/retire tools on strategy-mcp
# AERO_MCP_BEARER_TOKEN=generate-with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# docker compose only
POSTGRES_PASSWORD=CHANGE_ME
AERO_MCP_BEARER_TOKEN=CHANGE_ME

# ----------------------------------------------------------------------------
# v1 (frozen; app/ and scripts/*.sh) still reads these un-prefixed names.
# ----------------------------------------------------------------------------
SQLITE_DB_PATH=data/aero_ceo.sqlite
FAISS_INDEX_PATH=data/cache/aero_ceo.faiss
FAISS_METADATA_PATH=data/cache/faiss_metadata.json
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
LLM_GENERATION_ENABLED=false
LLM_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
